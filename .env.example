# ---------- Core ----------
NODE_ENV=development
APP_URL=https://campushub.az
DATABASE_URL="postgresql://campushub_app:pass@localhost:5432/campushub?schema=public&connection_limit=20"
DIRECT_DATABASE_URL="postgresql://campushub_migrator:pass@localhost:5432/campushub?schema=public"

# Redis serves three roles: rate limiting, BullMQ queues, and the encrypted
# review buffer for flagged verification cases.
#
# CRITICAL DEPLOYMENT REQUIREMENT: the instance backing the review buffer MUST
# run with persistence disabled --  `save ""` and `appendonly no`. With RDB
# snapshots enabled, Redis writes pending ID documents to dump.rdb and the
# zero-retention guarantee is silently broken. See docs/SECURITY.md section 3.
REDIS_URL="redis://localhost:6379"

# ---------- Auth ----------
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
# Server-side secret mixed into every hash of PII (emails, phones, devices).
# Held in KMS/Secrets Manager, never in the DB. Rotating it needs a re-hash plan.
PII_HASH_PEPPER=

# ---------- Storage ----------
# NOTE: there is no KYC bucket. Identity documents never reach object storage.
# These two hold ordinary user content only.
S3_REGION=eu-central-1
S3_BUCKET_PUBLIC=campushub-public          # avatars, post images, note previews
S3_BUCKET_NOTES=campushub-notes-private    # study-note PDFs, signed URLs only

# ---------- Verification pipeline ----------
DOC_VERIFIER_URL=http://doc-verifier:8000
DOC_VERIFIER_TOKEN=
# confidence >= AUTO_APPROVE -> VERIFIED automatically
# anything else              -> NEEDS_REVIEW (a human decides)
# There is deliberately no "auto-ban" threshold: the automated stage cannot
# ban. See decide() in src/lib/verification/policy.ts.
VERIFY_AUTO_APPROVE_THRESHOLD=0.88
# Only raises moderator queue priority; never decides an outcome.
VERIFY_SUSPICION_THRESHOLD=0.35
VERIFICATION_MAX_ATTEMPTS=3

# How long a FLAGGED case's documents stay in the encrypted Redis buffer so a
# moderator can review them. Clamped to [300, 259200] in code and capped at
# 72h by a CHECK constraint. Shorter is better; 24h is the default because it
# spans one working day plus a timezone.
REVIEW_BUFFER_TTL_SECONDS=86400

# ---------- Anti-fraud ----------
# Device blocks expire: a fingerprint is inherited by second-hand phones and
# shared lab machines. Account-identifier blocks (email/phone/user) are
# permanent and have no setting here.
#
# There is NO IP block setting. IP banning was removed - campus NAT and carrier
# CGNAT make it collective punishment. See docs/SECURITY.md section 4.
DEVICE_BLOCK_TTL_DAYS=180

# ---------- Payments / wallet ----------
PLATFORM_FEE_BPS=1500                # 15.00%
SELLER_CLEARING_HOURS=72             # refund window before seller funds unlock
PAYMENT_PROVIDER=epoint
PAYMENT_WEBHOOK_SECRET=

# ---------- Notifications ----------
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:security@campushub.az
RESEND_API_KEY=

# ---------- Meetings ----------
MEETING_PROVIDER=jitsi
JITSI_APP_ID=
JITSI_JWT_SECRET=

# ---------- Dev only ----------
# Lets /dashboard and /admin render without a session. Guarded by
# NODE_ENV !== 'production', which Next inlines and the minifier strips, so
# setting this on a production deploy does nothing.
# CAMPUSHUB_DEV_BYPASS_AUTH=1

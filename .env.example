# Campus Hub / UniPath - environment variables.
#
# NAMES ONLY. Never commit real values to this file. Server-side secrets must
# never be prefixed NEXT_PUBLIC_ (that inlines them into the browser bundle).
# In production a missing REQUIRED variable fails the server at startup
# (src/server/env-check.ts), listing the variable names.
#
# Firestore is the only database. There is no DATABASE_URL, REDIS_URL or S3.

# ---------- Core (REQUIRED) ----------
# Public base URL, used in email links. e.g. https://campushub.az
APP_URL=

# ---------- Auth (REQUIRED) ----------
# Ed25519 key pair, PEM, multi-line values in double quotes.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# Optional. Defaults: 900 seconds (students), 10800 (staff), 30 days.
ACCESS_TOKEN_TTL_SECONDS=
ADMIN_ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_DAYS=
# Idle ceiling on a session, in minutes. Default 30; 0 disables it.
# A session row unused for longer is revoked on the next request that finds it,
# which is what enforces "closing the browser signs you out" even when the
# browser restores its session cookies (Chrome's "continue where you left off").
# Raise it if sign-ins feel too frequent; it is not a security boundary on its
# own - logout and revocation are immediate regardless.
SESSION_IDLE_TIMEOUT_MINUTES=
# 64 hex chars. Mixed into every PII hash; also keys field encryption unless
# VAULT_KEY is set. Rotating it needs a re-hash plan.
PII_HASH_PEPPER=
# Optional. Separate key for encrypting booking meeting URLs at rest.
VAULT_KEY=

# ---------- Firebase (REQUIRED) ----------
# Client web config - identifies the project, not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Server. FIREBASE_SERVICE_ACCOUNT is a SECRET: the whole service-account JSON
# on one line (or use GOOGLE_APPLICATION_CREDENTIALS instead).
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT=
# Local emulators only:
# FIRESTORE_EMULATOR_HOST=
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# ---------- Cloudinary: registration verification images (REQUIRED) ----------
# Server-side only. Documents are uploaded as `authenticated` assets under
# campushub/kyc-review/<uuid>/ and deleted within 7 days.
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Review window in seconds; clamped to [300, 604800] (7 days).
REVIEW_BUFFER_TTL_SECONDS=

# Bearer token for GET /api/cron/verification-cleanup (REQUIRED).
# Vercel Cron sends it automatically; the schedule is in vercel.json.
CRON_SECRET=

# ---------- Verification pipeline ----------
# The doc-verifier service (services/doc-verifier). Without it every
# submission is routed to human review instead of being decided automatically.
DOC_VERIFIER_URL=
DOC_VERIFIER_TOKEN=
# Optional. Defaults 0.88 / 0.35 / 3.
VERIFY_AUTO_APPROVE_THRESHOLD=
VERIFY_SUSPICION_THRESHOLD=
VERIFICATION_MAX_ATTEMPTS=

# ---------- Email ----------
# Platform mailbox. GMAIL_APP_PASSWORD must be a Google APP PASSWORD
# (enable 2-Step Verification, then https://myaccount.google.com/apppasswords),
# not the account password. Check with: npm run email:verify [you@example.com]
# The platform sender. Every transactional email (account, security, mentor,
# wallet, notes, notifications) goes out from this mailbox. Failed deliveries
# are parked in the emailOutbox collection and retried by the scheduler or
# GET /api/cron/email-outbox (Bearer CRON_SECRET).
# NAMES ONLY - never a real value. This file is committed to git, so anything
# written here is published to everyone with repository access and must be
# treated as compromised and rotated.
GMAIL_USER=campushubsupport@gmail.com
GMAIL_APP_PASSWORD=
# Optional display name, e.g. "UniPath <mailbox>". The address used is always
# the authenticated mailbox.
EMAIL_FROM="CampusHub <campushubsupport@gmail.com>"
# Alternatives, used only when the Gmail pair is absent:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=campushubsupport@gmail.com
SMTP_PASSWORD=
RESEND_API_KEY=

# ---------- Anti-fraud ----------
# Optional. Days a device block lasts. Default 180.
DEVICE_BLOCK_TTL_DAYS=

# ---------- Payments / wallet ----------
# Optional. Defaults 1500 (15.00%) and 72 hours.
PLATFORM_FEE_BPS=
SELLER_CLEARING_HOURS=

# ---------- Meetings (mentor bookings) ----------
# Jitsi JWT credentials for meet.campushub.az. Without them a booking can be
# made but its call cannot be joined.
JITSI_APP_ID=
JITSI_JWT_SECRET=

# ---------- Dev only ----------
# Renders /dashboard and /admin without a session. Ignored in production.
# CAMPUSHUB_DEV_BYPASS_AUTH=1

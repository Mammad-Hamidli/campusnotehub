# CampusNoteHub / UniPath - environment variables.
#
# NAMES ONLY. Never commit real values to this file. Server-side secrets must
# never be prefixed NEXT_PUBLIC_ (that inlines them into the browser bundle).
# In production a missing REQUIRED variable fails the server at startup
# (src/server/env-check.ts), listing the variable names.
#
# Firestore is the only database. There is no DATABASE_URL, REDIS_URL or S3.

# ---------- Core (REQUIRED) ----------
# Canonical public origin: email links, OAuth redirect URIs, post-login
# redirects. Exactly https://www.campusnotehub.com in production - no trailing
# slash, www included. For local Google sign-in, override in .env.local with
APP_URL=http://localhost:3000
# APP_URL=https://www.campusnotehub.com
# Where "Mentor olmaq üçün müraciət et" (register page, /mentors/apply) sends
# people. Public by design (NEXT_PUBLIC_): it is a link, not a secret.
NEXT_PUBLIC_MENTORS_URL=https://mentors.campusnotehub.com

# ---------- Auth (REQUIRED) ----------
# Ed25519 key pair, PEM, multi-line values in double quotes.
JWT_PRIVATE_KEY_PEM=
JWT_PUBLIC_KEY_PEM=
# Optional. Defaults: 900 seconds (students), 10800 (staff), 30 days.
ACCESS_TOKEN_TTL_SECONDS=
ADMIN_ACCESS_TOKEN_TTL_SECONDS=
REFRESH_TOKEN_TTL_DAYS=
# Idle ceiling on a session, in minutes. Default 30; 0 disables it.
# A session row unused for longer is revoked on the next request that finds it,
# which is what enforces "closing the browser signs you out" even when the
# browser restores its session cookies (Chrome's "continue where you left off").
# Raise it if sign-ins feel too frequent; it is not a security boundary on its
# own - logout and revocation are immediate regardless.
SESSION_IDLE_TIMEOUT_MINUTES=
# 64 hex chars. Mixed into every PII hash; also keys field encryption unless
# VAULT_KEY is set. Rotating it needs a re-hash plan.
PII_HASH_PEPPER=
# Optional. Separate key for encrypting booking meeting URLs at rest.
VAULT_KEY=

# ---------- Firebase (REQUIRED) ----------
# Client web config - identifies the project, not secret.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
# Server. FIREBASE_SERVICE_ACCOUNT is a SECRET: the whole service-account JSON
# on one line (or use GOOGLE_APPLICATION_CREDENTIALS instead).
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_SERVICE_ACCOUNT=
# Local emulators only:
# FIRESTORE_EMULATOR_HOST=
# NEXT_PUBLIC_FIRESTORE_EMULATOR_HOST=
# NEXT_PUBLIC_FIREBASE_AUTH_EMULATOR_HOST=

# ---------- Cloudinary: registration verification images (REQUIRED) ----------
# Server-side only. Documents are uploaded as `authenticated` assets under
# campusnotehub/kyc-review/<uuid>/ and deleted within 7 days.
# Alternatively: CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Optional. Review window in seconds; clamped to [300, 604800] (7 days).
REVIEW_BUFFER_TTL_SECONDS=

# Bearer token for GET /api/cron/verification-cleanup (REQUIRED).
# Vercel Cron sends it automatically; the schedule is in vercel.json.
CRON_SECRET=

# ---------- Verification pipeline ----------
# The doc-verifier service (services/doc-verifier). Without it every
# submission is routed to human review instead of being decided automatically.
DOC_VERIFIER_URL=
DOC_VERIFIER_TOKEN=
# Optional. Defaults 0.88 / 0.35 / 3.
VERIFY_AUTO_APPROVE_THRESHOLD=
VERIFY_SUSPICION_THRESHOLD=
VERIFICATION_MAX_ATTEMPTS=

# ---------- Email ----------
# ONE Gmail mailbox, and nothing else. src/lib/email/identity.ts holds a closed
# allowlist and refuses any other address - a personal mailbox must never send
# as, or be read by, this application.
#
#   supportcampushub@gmail.com   authenticates to SMTP, signs outbound mail,
#                                carries Reply-To, and is the IMAP mailbox
#                                drained for support replies
#
# The password is a Google APP PASSWORD, not the account password: enable
# 2-Step Verification, then https://myaccount.google.com/apppasswords. The same
# one works for SMTP and IMAP. Check both directions with:
#   npm run email:verify [you@example.com]
#
# NAMES ONLY - never a real value. This file is committed to git, so anything
# written here is published to everyone with repository access and must be
# treated as compromised and rotated. Real values go in .env (gitignored).

# --- Outbound (SMTP) ---
EMAIL_FROM="CampusNoteHub <supportcampusnhub@gmail.com>"
# Optional; overrides the display name parsed out of EMAIL_FROM.
EMAIL_SENDER_NAME=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=supportcampushub@gmail.com
SMTP_PASSWORD=

# --- Inbound (IMAP) ---
# Drained hourly by GET /api/cron/support-inbox into the supportInbox
# collection; npm run email:inbox does the same from a shell. IMAP access must
# be switched on for the mailbox: Gmail > Settings > Forwarding and POP/IMAP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=supportcampushub@gmail.com
IMAP_PASSWORD=

# --- Shared ---
# The address printed in email footers and on the legal pages.
EMAIL_SUPPORT_ADDRESS=supportcampushub@gmail.com
# Fallback transport, same address. Requires the domain verified in Resend.
RESEND_API_KEY=

# --- Branding, all optional (src/lib/email/branding.ts) ---
EMAIL_COMPANY_NAME=
EMAIL_COMPANY_ADDRESS=
EMAIL_UNSUBSCRIBE_URL=
EMAIL_SOCIAL_INSTAGRAM_URL=
EMAIL_SOCIAL_LINKEDIN_URL=
EMAIL_SOCIAL_FACEBOOK_URL=
# Logo/icon delivery: how templates reference image assets.
EMAIL_ASSET_MODE=
EMAIL_ASSET_BASE_URL=
EMAIL_ASSET_DIR=

# ---------- Anti-fraud ----------
# Optional. Days a device block lasts. Default 180.
DEVICE_BLOCK_TTL_DAYS=

# ---------- Payments / wallet ----------
# Optional. Defaults 1500 (15.00%) and 72 hours.
PLATFORM_FEE_BPS=
SELLER_CLEARING_HOURS=

# ---------- Meetings (mentor bookings) ----------
# Jitsi JWT credentials for meet.campusnotehub.com. Without them a booking can be
# made but its call cannot be joined.
JITSI_APP_ID=
JITSI_JWT_SECRET=

# ---------- Social sign-in (optional) ----------
# Each provider appears on /login only when ALL of its variables are set.
# Redirect URI to register with each provider:
#   ${APP_URL}/api/auth/oauth/<google|microsoft|apple>/callback
# Google: OAuth client of type "Web application".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Dev only ----------
# Renders /dashboard and /admin without a session. Ignored in production.
# campusnotehub_DEV_BYPASS_AUTH=1

{
  "name": "campushub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/clean-next.mjs",
    "dev": "next dev",
    "dev:preview": "node scripts/clean-next.mjs && cross-env CAMPUSHUB_DEV_BYPASS_AUTH=1 next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-keys-used.mjs",
    "test": "vitest run",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:invariants": "psql \"$DIRECT_DATABASE_URL\" -f prisma/migrations/manual/0001_invariants.sql -f prisma/migrations/manual/0002_zero_retention.sql",
    "db:seed": "tsx prisma/seed.ts",
    "cron:graduation": "tsx src/server/cron/graduation.ts",
    "worker:notes": "tsx src/server/queue/notes.worker.ts",
    "worker:notify": "tsx src/server/queue/notifications.worker.ts",
    "worker:scheduler": "tsx src/server/cron/scheduler.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.717.0",
    "@aws-sdk/client-rekognition": "^3.717.0",
    "@aws-sdk/client-s3": "^3.717.0",
    "@aws-sdk/s3-presigned-post": "^3.717.0",
    "@aws-sdk/s3-request-presigner": "^3.717.0",
    "@hookform/resolvers": "^3.9.1",
    "@prisma/client": "^6.2.0",
    "@tanstack/react-query": "^5.62.0",
    "argon2": "^0.41.1",
    "bcrypt": "^5.1.1",
    "bullmq": "^5.34.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "ioredis": "^5.4.1",
    "jose": "^5.9.6",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.9.155",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.54.0",
    "resend": "^4.0.1",
    "sharp": "^0.33.5",
    "web-push": "^3.6.7",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "postcss": "^8.4.49",
    "prisma": "^6.2.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}

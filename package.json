{
  "name": "campushub",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "predev": "node scripts/clean-next.mjs",
    "dev": "next dev --turbopack",
    "dev:webpack": "node scripts/clean-next.mjs && next dev",
    "dev:preview": "node scripts/clean-next.mjs && cross-env CAMPUSHUB_DEV_BYPASS_AUTH=1 next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs && node scripts/check-keys-used.mjs",
    "test": "vitest run",
    "cron:graduation": "tsx src/server/cron/graduation.ts",
    "worker:scheduler": "tsx src/server/cron/scheduler.ts",
    "email:verify": "node scripts/verify-email.mjs",
    "test:e2e": "node scripts/e2e.mjs",
    "seed:e2e": "tsx scripts/seed-e2e.mts",
    "seed:universities": "tsx scripts/seed-universities.mts",
    "firebase:emulators": "firebase emulators:start --project campushub-local",
    "test:firebase-rules": "tsx scripts/test-firebase-rules.mts"
  },
  "dependencies": {
    "argon2": "^0.41.1",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "exceljs": "^4.4.0",
    "firebase": "^12.18.0",
    "firebase-admin": "^14.3.0",
    "jose": "4.15.9",
    "lucide-react": "^0.469.0",
    "next": "^15.1.0",
    "nodemailer": "^10.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "resend": "^4.0.1",
    "server-only": "^0.0.1",
    "sharp": "^0.33.5",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.2.7",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "firebase-tools": "^15.29.0",
    "playwright": "^1.63.0",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "overrides": {
    "jose": "$jose",
    "jwks-rsa": "^3.1.0"
  },
  "resolutions": {
    "jose": "4.15.9",
    "jwks-rsa": "^3.1.0"
  }
}
